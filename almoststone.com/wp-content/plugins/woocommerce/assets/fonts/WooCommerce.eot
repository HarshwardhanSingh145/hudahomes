<!-- Contact Form 7 - Flamingo Mail Failed Visual Fallback -->
<script>
document.addEventListener('wpcf7submit', function(event) {

    // If the form data was captured by Flamingo
    // but the notification email failed
    if (event.detail.status === 'mail_failed') {

        // Find the form's feedback response box
        const responseBox = document.querySelector(
            event.detail.into + ' .wpcf7-response-output'
        );

        if (responseBox) {
            responseBox.style.display = 'block';
            responseBox.style.borderColor = '#c5a880';
            responseBox.style.backgroundColor = '#fcf9f5';
            responseBox.style.color = '#000000';
            responseBox.style.padding = '12px';
            responseBox.style.marginTop = '15px';
            responseBox.style.textAlign = 'center';
            responseBox.style.fontSize = '14px';

            responseBox.textContent =
                'Thank you! Your quote request has been received successfully.';
        }
    }

}, false);
</script>


<!-- Meta Pixel Lead Event - Request a Quote -->
<script>
document.addEventListener('wpcf7submit', function(event) {

    // Actual Quote Request form ID confirmed from the live CF7 event
    if (String(event.detail.contactFormId) === '1037') {

        // Count the submission as a Lead if:
        // 1. Email was successfully sent, OR
        // 2. Email failed but Flamingo captured the enquiry
        if (
            event.detail.status === 'mail_sent' ||
            event.detail.status === 'mail_failed'
        ) {

            // Make sure Meta Pixel is available
            if (typeof fbq === 'function') {
                fbq('track', 'Lead');

                console.log(
                    'Meta Lead event fired for Quote Request - CF7 Form 1037'
                );
            } else {
                console.warn(
                    'Meta Pixel is not loaded - Lead event could not be fired'
                );
            }
        }
    }

}, false);
</script>
