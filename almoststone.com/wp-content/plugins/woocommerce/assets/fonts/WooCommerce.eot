		<style type="text/css" id="wp-custom-css">
			:root {
	/* Product arrows size */
	--extra-img-arrow-size: 30px;
	/* Ajax load more button font size */
	--load-more-btn-fz: 1rem;
	/* Product page, nav. arrow size */
	--pdp-post-nav-fz: 26px;
}

:is(.related.products,.upsells.products,.crosssells.products,.rey-extra-products)>h2 {
	color: #222;
	font-size: 24px;
	font-weight: 700;
	text-transform: unset;
	margin-bottom: 1em;
}

.rey-productAttribute {
	text-transform: none;
	font-size: 12px;
}
/* ==========================================================================
   ALMOST STONE - SIDE-BY-SIDE MATCHING BUTTON ROW (RIGHT OPENING VARIANT)
   ========================================================================== */

/* Force horizontal layout structure on both desktop and mobile views */
.pdp-unified-action-row {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    justify-content: flex-start !important;
    gap: 12px !important;
    margin: 20px 0 !important;
    width: 100% !important;
    clear: both !important;
}

/* Ensure containers act as clean inline elements */
.pdp-unified-action-row .action-row-item-box {
    display: inline-flex !important;
    position: relative !important;
}

/* Force Rey's native button wrapper to stop hogging 100% width */
.pdp-unified-action-row .rey-wishlistBtn-wrapper {
    width: auto !important;
    margin: 0 !important;
    display: inline-block !important;
}

/* Target and enforce matching design layout rules for both boxes */
.pdp-unified-action-row .wishlist-box-target button.rey-wishlistBtn,
.pdp-unified-action-row .share-trigger-box {
    width: 48px !important;
    height: 48px !important;
    min-width: 48px !important;
    max-width: 48px !important;
    box-sizing: border-box !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    background: transparent !important;
    border: 1px solid #111111 !important;
    border-radius: 0px !important;
    cursor: pointer !important;
    color: #111111 !important;
    padding: 12px !important;
    margin: 0 !important;
    box-shadow: none !important;
    transition: background-color 0.3s ease, color 0.3s ease !important;
}

/* Match vector scaling rules */
.pdp-unified-action-row svg,
.pdp-unified-action-row .wishlist-box-target svg {
    width: 18px !important;
    height: 18px !important;
    display: block !important;
}

/* Make sure the inner icon path elements inherit the bold stroke metrics */
.pdp-unified-action-row .share-trigger-box svg * {
    stroke-width: 2.2 !important;
}

/* Subtle hover background tint logic */
.pdp-unified-action-row .share-trigger-box:hover,
.pdp-unified-action-row .wishlist-box-target button.rey-wishlistBtn:hover {
    background-color: #fbfbfa !important; 
    color: #8c734b !important; 
    border-color: #111111 !important;
}

/* SIDE-ALIGNING DROP-DOWN MATRIX OVERRIDES */
.custom-square-share-gate:hover .share-dropdown-vault {
    opacity: 1 !important;
    visibility: visible !important;
    transform: translateY(-50%) translateX(0) !important;
}

.share-dropdown-vault {
    position: absolute !important;
    top: 50% !important;
    left: 115% !important; /* Positions panel directly off to the right edge */
    transform: translateY(-50%) translateX(-10px) !important;
    background: #ffffff !important;
    border: 1px solid #eae7e2 !important;
    border-radius: 2px !important;
    padding: 6px 0 !important;
    min-width: 110px !important;
    box-shadow: 8px 8px 25px rgba(0,0,0,0.06) !important;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94) !important;
    z-index: 999 !important;
    display: flex !important;
    flex-direction: column !important;
}

.share-dropdown-vault a {
    font-family: 'Jost', sans-serif !important;
    font-size: 12px !important;
    color: #111111 !important;
    text-decoration: none !important;
    padding: 6px 14px !important;
    text-align: left !important; /* Left aligned layout looks cleaner when popping out sideways */
    transition: background 0.2s ease, color 0.2s ease !important;
}

.share-dropdown-vault a:hover {
    background-color: #fbfbfa !important;
    color: #8c734b !important;
}
/* Hide the Rey Theme product reviews toggle button */
#toggle-reviews-button.rey-reviewsBtn {
    display: none !important;
}
/* --- High-Density Right Side Contact Form Optimization --- */
.custom-contact-form-wrapper {
    display: flex !important;
    flex-direction: column !important;
    gap: 12px !important; /* Cut spacing exactly in half */
}

/* Eliminate excessive container margins generated by CF7 paragraphs */
.custom-contact-form-wrapper p,
.custom-contact-form-wrapper .wpcf7-form-control-wrap {
    margin: 0 !important;
    padding: 0 !important;
}

.custom-contact-form-wrapper .form-field-group {
    display: flex !important;
    flex-direction: column !important;
    gap: 4px !important; /* Tight margin between text label and input line */
    margin-bottom: 4px !important;
}

/* Match the exact small uppercase labels from the left column */
.custom-contact-form-wrapper label {
    font-family: 'Jost', sans-serif !important;
    font-size: 11px !important; /* Slightly smaller to match high-density aesthetic */
    font-weight: 600 !important;
    text-transform: uppercase !important;
    letter-spacing: 1.5px !important;
    color: #111111 !important;
    margin: 0 !important;
    padding: 0 !important;
}

/* Premium Ultra-Flat Minimalist Inputs & Textarea Styles */
.custom-contact-form-wrapper input[type="text"],
.custom-contact-form-wrapper input[type="email"],
.custom-contact-form-wrapper input[type="tel"],
.custom-contact-form-wrapper textarea {
    width: 100% !important;
    font-family: 'Jost', sans-serif !important;
    font-size: 14px !important;
    color: #111111 !important;
    background-color: transparent !important;
    border: none !important;
    border-bottom: 1px solid #eae7e2 !important; /* Clean linear underline style */
    padding: 6px 0 !important; /* Reduced vertical inner padding */
    margin: 0 !important;
    border-radius: 0 !important;
    transition: border-color 0.3s ease !important;
    box-shadow: none !important;
}

/* Subtle placeholder formatting */
.custom-contact-form-wrapper ::placeholder {
    color: #b3b3b3 !important;
    opacity: 0.8 !important;
}

/* Micro-interaction on input line hover/focus */
.custom-contact-form-wrapper input:focus,
.custom-contact-form-wrapper textarea:focus {
    outline: none !important;
    border-bottom: 1px solid #8c734b !important;
}

/* Compact Textarea Dimensions */
.custom-contact-form-wrapper textarea {
    height: 75px !important; /* Reduced default box size */
    resize: vertical !important;
}

/* Compact Submit Action Row */
.custom-contact-form-wrapper .form-submit-group {
    margin-top: 6px !important;
}

.custom-contact-form-wrapper input[type="submit"] {
    font-family: 'Jost', sans-serif !important;
    font-size: 12px !important;
    font-weight: 600 !important;
    text-transform: uppercase !important;
    letter-spacing: 2px !important;
    color: #ffffff !important;
    background-color: #111111 !important;
    border: 1px solid #111111 !important;
    padding: 12px 32px !important; /* Slightly smaller button profile */
    border-radius: 0 !important;
    cursor: pointer !important;
    transition: all 0.3s ease !important;
    width: auto !important;
    display: inline-block !important;
}

.custom-contact-form-wrapper input[type="submit"]:hover {
    background-color: #8c734b !important;
    border-color: #8c734b !important;
}
.page-id-1270 .rey-pageTitle.entry-title {
    display: none !important;
}
/* --- ACCURATE ACTIONS ROW WRAPPER --- */
.actions-row-wrapper {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    gap: 12px !important;
    margin: 15px 0 !important;
    width: 100% !important;
    clear: both !important;
}

/* Force both elements to render as crisp, identical squares */
.actions-row-wrapper .rey-wishlistBtn,
.actions-row-wrapper .share-trigger-box {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 46px !important;
    height: 46px !important;
    min-width: 46px !important;
    max-width: 46px !important;
    padding: 0 !important;
    margin: 0 !important;
    box-sizing: border-box !important;
}

/* Share button icon formatting override */
.actions-row-wrapper .share-trigger-box {
    border: 1px solid #e0e0e0 !important;
    background: transparent !important;
    cursor: pointer !important;
}

.actions-row-wrapper .share-trigger-box svg {
    width: 18px !important;
    height: 18px !important;
    display: block !important;
    margin: 0 auto !important;
    padding: 0 !important;
}
/* --- HIDE SHARE ROW FROM REY QUICK VIEW MODAL --- */
.rey-modal .pdp-unified-action-row,
.rey-quickview-content .pdp-unified-action-row,
[class*="rey-quickview"] .pdp-unified-action-row,
.rey-modal .custom-square-share-gate,
[class*="quickview"] .custom-square-share-gate {
    display: none !important;
}
/* Target the Dealer Program page specifically via standard WordPress body class */
body.page-template-default[class*="dealer-program"] .rey-pageTitle,
body[class*="dealer-program"] .rey-pageHeader {
    display: none !important;
}

/* Target the Career page specifically via standard WordPress body class */
body.page-template-default[class*="career"] .rey-pageTitle,
body[class*="career"] .rey-pageHeader {
    display: none !important;
}
.woocommerce-ordering,
select.orderby,
#catalog-orderby-list {
    display: none !important;
}
.woocommerce-ordering,
select.orderby,
#catalog-orderby-list {
    display: none !important;
}

.__loop-separator {
    display: none !important;
}		</style>
